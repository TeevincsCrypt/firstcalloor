# X API v2 bearer token. Needs a tier with search access:
#   Free  -> no search at all, use --mock
#   Basic -> recent search, 7-day lookback
#   Pro   -> full-archive search, pass --full-archive
# developer.x.com -> your App -> Keys and tokens -> Bearer Token
X_BEARER_TOKEN=

# Solana RPC. Defaults to https://api.mainnet-beta.solana.com when unset.
# A free Helius key is worth it if the public endpoint rate-limits you.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
